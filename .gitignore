# Claude Code: share the project skills, keep machine-local settings out.
.claude/settings.local.json
.gitflow/

# Everything a run writes stays local. Tracking a path that the pipeline also
# writes makes `git pull` fail on any machine that generated the same file, and
# it pins the output of whichever machine committed first.
data/
results/

# Evidence worth keeping in the repository is copied into evidence/ by hand.
# No command writes there, so it never collides with a run.
